#!/usr/bin/env bash
# 대시보드에 명령 보내기 / 현황 읽기.  예) ./market status | ./market outbreak 3 | ./market focus WEB-2B1
set -euo pipefail
DIR="${XMAS_MARKET_RUNTIME:-$(cd "$(dirname "$0")" && pwd)/.runtime}"
mkdir -p "$DIR"
case "${1:-help}" in
  status)
    [ -f "$DIR/state.json" ] || { echo "대시보드가 실행 중이 아니다 (state.json 없음)"; exit 1; }
    cat "$DIR/state.json" ;;
  help|-h|--help)
    cat <<'H'
./market status                 현황 JSON (단계·서비스·트래픽·쥐·병정·통계·최근 로그·현재 화면)
./market start <서비스> [traffic|sentry|overview|agents]   스테이지 시작 (서비스: ALL WEB SEARCH RESUME DISPLAY MOBILE)
./market view menu|overview|traffic|sentry|agents   화면 전환 (메뉴 / 개요 / 대기열 / 전투 / 에이전트)
./market spike                  트래픽 급증
./market outbreak [N] [server]  쥐 떼 N마리 (기본 5, server 면 서버 에러 쥐)
./market mouse                  쥐 1마리
./market focus <ISSUE-ID>       병정이 그 쥐부터 처치
./market tell <병정> <명령>      병정(서브 에이전트)에게 말로 명령. 병정: 1·2·3·루돌프·진저·호두·모두
                                예) tell 2 WEB-2B1 먼저 잡아 / tell 모두 보고 / tell 1 복귀 / tell 3 출동
./market tell 엘프 <말>           엘프(트래픽 대응)에게: 캐시 켜/꺼 · 계산대 6 · 번호표 켜/꺼 · 승인 · 거절 · 원복 · 보고 · 자동 꺼/켜
                                (= ./market elf <말>, OpenAI 안 씀)
./market history [ISSUE-ID|off] 잡은 쥐 기록 창 (ID 를 주면 그 쥐 줄 강조)
./market kb [ISSUE-ID]          이슈의 참고 사례·검색 이유·업무 규칙을 기록 창에 표시
./market prs                    병정이 실제로 연 PR 목록을 로그에 (--live + XMAS_FIX_REPO 일 때)
./market human                  우리 속(needs-human) 쥐 처리 완료
./market brief                  AI 운영 브리핑 (현황 3줄 + 권고. AI 가 꺼져 있으면 숫자 한 줄)
./market report                 사후 보고서 → .runtime/reports/*.md (처리 이슈·PR·Codex 리뷰·엘프 조치. AI 면 요약·원인·할 일, OpenAI 1회)
./market say <메시지>            대시보드 로그에 메시지 표시
./market auto on|off            자동 연출
./market pause | resume
H
    ;;
  *) printf '%s\n' "$*" >> "$DIR/cmd"; echo "sent: $*" ;;
esac
