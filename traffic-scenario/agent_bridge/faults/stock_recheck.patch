+def stock(con, seed):
+    con.execute("CREATE TABLE IF NOT EXISTS stock(product_id INTEGER PRIMARY KEY,quantity INTEGER NOT NULL)")
+
+    if con.execute("SELECT 1 FROM stock LIMIT 1").fetchone():
+        return
+
+    rng = random.Random(seed)
+    ids = [r[0] for r in con.execute("SELECT product_id FROM products ORDER BY product_id")]
+    con.executemany("INSERT INTO stock VALUES(?,?)", ((i, rng.randint(1, 20) if rng.random() < 0.01 else 0) for i in ids))
+
