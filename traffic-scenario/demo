#!/usr/bin/env bash
# 시연 준비와 유입과 Codex 요청을 한 명령씩으로 실행
set -euo pipefail
cd "$(dirname "$0")"
PYTHON=.venv/bin/python
# 두 터미널이 같은 상품 DB와 비교 정책을 보도록 한곳에서 지정
export MBM_DATA_DIR="${MBM_DATA_DIR:-data/demo-1m}"
export MBM_PRODUCT_COUNT="${MBM_PRODUCT_COUNT:-1000000}"
export MBM_POLICIES="${MBM_POLICIES:-agent_bridge/policies.json}"
REQUEST='$performance-repair 기획전 트래픽이 유입됐다. 고객이 제시간에 올바른 검색 결과를 받는지 확인하고 변경이 필요하면 근거와 함께 수정하라.'

case "${1:-help}" in
  a|b|c)
    # 상품 DB가 없을 때만 만든다. 100만 건이라 처음 한 번은 시간이 걸린다
    [ -f "$MBM_DATA_DIR/catalog.sqlite" ] || "$PYTHON" -B -m backend seed
    "$PYTHON" -B -m agent_bridge scenario "$1"
    ./run.sh
    ;;
  surge)
    "$PYTHON" -B -m agent_bridge surge
    ;;
  codex)
    # Codex 구독 한도를 쓰는 유료 실행
    codex exec -s workspace-write -c sandbox_workspace_write.network_access=true "$REQUEST"
    ;;
  test)
    "$PYTHON" -B -m pytest -q -p no:cacheprovider
    ;;
  *)
    echo './demo a|b|c   출발 상태를 맞추고 서버와 화면을 켠다'
    echo './demo surge   켜져 있는 화면에 무작위 고객 급증을 보낸다'
    echo './demo codex   Codex에게 성능 문제 대응을 요청한다 (유료)'
    echo './demo test    테스트를 실행한다'
    ;;
esac
